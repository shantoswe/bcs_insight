# ============================================================
#  AUS Prep — environment variables
#  Copy to .env and fill in real values (never commit .env)
# ============================================================

# ---- Supabase (Settings → API in the Supabase dashboard) ----
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only, bypasses RLS

# ---- Database (Supabase → Connect) ----
# Pooled connection (pgBouncer, port 6543) used by the app at runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma migrations only.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Bunny Stream (video hosting + direct browser upload) ----
# Dashboard: Bunny.net → Stream → your Video Library
BUNNY_STREAM_API_KEY="your-stream-library-api-key"   # server-only; signs upload + create-video
# Library ID is public (it appears in every embed URL) — needed in the browser
# for the iframe player and the TUS direct upload.
NEXT_PUBLIC_BUNNY_LIBRARY_ID="123456"
# Pull-zone CDN hostname for HLS/thumbnails, e.g. vz-abcd1234.b-cdn.net
NEXT_PUBLIC_BUNNY_CDN_HOST="vz-xxxxxxxx.b-cdn.net"
# Token Authentication key (Bunny library → Security). When set, playback URLs
# are signed + short-lived + enrollment-gated so videos can't be hotlinked or
# downloaded. Leave blank to use plain (unsigned) embeds during development.
BUNNY_STREAM_TOKEN_AUTH_KEY=""

# ---- Analytics & conversion tracking ----
# Public IDs may also be set from the admin panel (Homepage & SEO → Tracking);
# these env values are the defaults / fallback. Secrets are env-only.
#
# Meta (Facebook) Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=""            # public Pixel/Dataset ID, e.g. 1234567890
META_CONVERSIONS_API_TOKEN=""           # secret — Events Manager → Conversions API → access token
META_TEST_EVENT_CODE=""                 # optional, only while testing in Events Manager
#
# Google Analytics 4 (gtag) + Measurement Protocol
NEXT_PUBLIC_GA_MEASUREMENT_ID=""        # public, e.g. G-XXXXXXXXXX
GA_API_SECRET=""                        # secret — GA4 Admin → Data Streams → Measurement Protocol API secrets
#
# Optional: Google Tag Manager container
NEXT_PUBLIC_GTM_ID=""                   # e.g. GTM-XXXXXXX

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # production: https://yourdomain.com
PORT="3000"
# Long random string protecting the live-exam cron endpoint (/api/v1/cron/exams)
CRON_SECRET="change-me-to-a-long-random-string"
